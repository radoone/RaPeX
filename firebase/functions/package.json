{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint src safety_gate_fields.js",
    "build": "rm -rf lib && tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill:history": "node lib/scripts/backfill-history.js",
    "scan": "tsx src/scripts/trigger-store-scan.ts"
  },
  "main": "lib/index.js",
  "type": "module",
  "dependencies": {
    "@genkit-ai/firebase": "1.43.0",
    "@genkit-ai/google-genai": "1.43.0",
    "axios": "1.21.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "genkit": "1.43.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15"
  },
  "private": true,
  "engines": {
    "node": "22"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.12.0",
    "uuid": "11.1.1"
  }
}
